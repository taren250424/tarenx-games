{
  "name": "tarenx-games-monorepo",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r run dev",
    "build": "pnpm -r run build && pnpm run sitemap",

    "lint": "pnpm -r run lint",

    "dev:hub": "pnpm --filter hub run dev",
    "build:hub": "pnpm --filter hub run build",
    "dev:sokoban": "pnpm --filter sokoban run dev",
    "build:sokoban": "pnpm --filter sokoban run build",
    "dev:blockdrop": "pnpm --filter blockdrop run dev",
    "build:blockdrop": "pnpm --filter blockdrop run build",
    "dev:sudoku": "pnpm --filter sudoku run dev",
    "build:sudoku": "pnpm --filter sudoku run build",
    "dev:minesweeper": "pnpm --filter minesweeper run dev",
    "build:minesweeper": "pnpm --filter minesweeper run build",
    "dev:2048": "pnpm --filter 2048 run dev",
    "build:2048": "pnpm --filter 2048 run build",
    "dev:word-guess": "pnpm --filter word-guess run dev",
    "build:word-guess": "pnpm --filter word-guess run build",

    "preview": "pnpm run build && node scripts/preview.mjs",
    "deploy": "pnpm run build && node scripts/deploy.mjs",
    "sitemap": "node scripts/sitemap.mjs"
  },
  "packageManager": "pnpm@10.26.2+sha512.0e308ff2005fc7410366f154f625f6631ab2b16b1d2e70238444dd6ae9d630a8482d92a451144debc492416896ed16f7b114a86ec68b8404b2443869e68ffda6",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "vite-plugin-static-copy": "^4.1.0"
  }
}
